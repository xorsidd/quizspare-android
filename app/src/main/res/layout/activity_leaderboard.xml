<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Category Filter Spinner -->
    <Spinner
        android:id="@+id/spLdrCategoryFilter"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_stat_box"
        android:paddingHorizontal="12dp" />

    <TextView
        android:id="@+id/tvLdrEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="40dp"
        android:text="No attempts recorded yet for this subject."
        android:textColor="@color/text_secondary"
        android:visibility="gone" />

    <!-- RecyclerView Leaderboard List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvLeaderboardList"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="12dp" />

</LinearLayout>
