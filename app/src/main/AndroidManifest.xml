<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/btn_star_big_on"
        android:label="@string/app_name"
        android:roundIcon="@android:drawable/btn_star_big_on"
        android:supportsRtl="true"
        android:theme="@style/Theme.QuizSphere">

        <!-- Splash & Launch Screen -->
        <activity
            android:name=".activities.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.QuizSphere.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Authentication (Student Only) -->
        <activity
            android:name=".activities.LoginActivity"
            android:exported="false" />

        <activity
            android:name=".activities.RegisterActivity"
            android:exported="false"
            android:parentActivityName=".activities.LoginActivity" />

        <!-- Main Student Hub -->
        <activity
            android:name=".activities.MainActivity"
            android:exported="false" />

        <!-- Quiz Activities -->
        <activity
            android:name=".activities.CategoryListActivity"
            android:exported="false"
            android:parentActivityName=".activities.MainActivity" />

        <activity
            android:name=".activities.QuizDetailActivity"
            android:exported="false"
            android:parentActivityName=".activities.CategoryListActivity" />

        <activity
            android:name=".activities.QuizTakeActivity"
            android:exported="false" />

        <activity
            android:name=".activities.QuizResultActivity"
            android:exported="false" />

        <!-- Analytics & Leaderboard -->
        <activity
            android:name=".activities.LeaderboardActivity"
            android:exported="false"
            android:parentActivityName=".activities.MainActivity" />

        <activity
            android:name=".activities.DashboardActivity"
            android:exported="false"
            android:parentActivityName=".activities.MainActivity" />

        <!-- Presentation Showcase (Slide 1 to 12) -->
        <activity
            android:name=".activities.PresentationShowcaseActivity"
            android:exported="false"
            android:parentActivityName=".activities.MainActivity" />

    </application>

</manifest>
